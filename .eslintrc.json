{
    "env": {
        "browser": true,
        "es2017": true,
        "amd": true
    },
    "parserOptions": {
        "ecmaVersion": 2017,
        "sourceType": "script"
    },
    "globals": {
        "webapis": "readonly",
        "focusItemNo": "writable",
        "links": "writable",
        "setFocus": "readonly",
        "clamp": "readonly",
        "requirejs": "readonly"
    },
    "rules": {
        "no-undef": "error",
        "no-unused-vars": [
            "warn",
            {
                "args": "none"
            }
        ],
        "no-console": "off",
        "eqeqeq": [
            "error",
            "always"
        ],
        "semi": [
            "error",
            "always"
        ],
        /* --- High Value Additions --- */
        "no-var": "error",
        "prefer-const": "warn",
        "no-global-assign": "error",
        "no-redeclare": "error",
        "no-unreachable": "error",
        "no-duplicate-case": "error",
        "curly": [
            "error",
            "multi"
        ],
        "nonblock-statement-body-position": "off"
    },
    "overrides": [
        {
            "files": [
                "vite.config.js"
            ],
            "parserOptions": {
                "sourceType": "module"
            }
        }
    ],
    "ignorePatterns": [
        "chrome-linux",
        "3rd_party",
        "spatial_navigation.js",
        "require.js"
    ]
}