{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in|Local:"
        }
      }
    },
    {
      "type": "shell",
      "label": "Start Tizen Chrome 79",
      "command": "HOST_IP=$(ip route show default | awk '{print $3}') && docker run --rm -it --net=host --ipc=host --user root -e DISPLAY=:0 -v /mnt/wslg/.X11-unix:/tmp/.X11-unix:ro -v /mnt/wslg:/mnt/wslg chrome79 --no-sandbox http://${HOST_IP}:5173",
      "options": {
        "shell": {
          "executable": "wsl.exe",
          "args": [
            "-d",
            "Ubuntu",
            "bash",
            "-l",
            "-c"
          ]
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Set X11 Permissions",
      "type": "shell",
      "command": "xhost +local:docker",
      "problemMatcher": []
    },
    {
      "label": "Prepare Environment",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "dependsOn": [
        "Start Vite Server",
        // "Set X11 Permissions"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rebuild Tizen 4 Docker Image (Manual)",
      "type": "shell",
      "command": "docker build -f Dockerfile.tizen -t chrome56-tizen-test .",
      "problemMatcher": []
    },
    {
      "label": "Ollama: Load Code Model",
      "type": "shell",
      "command": "ollama run qwen2.5-coder:0.5b ''",
      "runOptions": {
        // "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Ollama: Stop Model & Free RAM",
      "type": "shell",
      "command": "ollama stop qwen2.5-coder:0.5b",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}