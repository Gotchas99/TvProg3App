{
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "userDataDir": true,
            "preLaunchTask": "npm: dev",
            "runtimeArgs": [
                "--hide-crash-restore-bubble",
                "--no-first-run",
                "--no-default-browser-check"
            ]
        },
        {
            "name": "Attach to Chrome",
            "port": 5173,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        }
    ]
}