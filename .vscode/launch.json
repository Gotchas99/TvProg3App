{
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "reloadOnAttach": true,
            "name": "Fox Launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preferences": {
                "browser.cache.disk.enable": false,
                "browser.cache.memory.enable": false,
                "devtools.debugger.remote-enabled": true
            }
        },
        {
            "type": "firefox",
            "request": "attach",
            "name": "Fox Attach",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://localhost:5173",
                    "path": "${workspaceFolder}"
                }
            ]
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "userDataDir": true,
            "preLaunchTask": "Start Vite Server",
            "runtimeArgs": [
                "--hide-crash-restore-bubble",
                "--no-first-run",
                "--no-default-browser-check"
            ]
        },
        {
            "name": "Docker Launch Tizen 4",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker run --rm -it --net=host --privileged -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix chrome56-tizen-test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Prepare Environment"
        }
    ]
}