{
  "compilerOptions": {
    "checkJs": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "target": "ES2017",
    "lib": [
      "DOM",
      "ES2017"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".git",
    "src/3rd_party/**/*"
  ]
}